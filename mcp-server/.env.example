# ─── Servidor MCP ─────────────────────────────────────────────────────────────
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_SERVER_NAME=ia-skills-mcp
MCP_SERVER_VERSION=1.0.0

# ─── GitLab ────────────────────────────────────────────────────────────────────
GITLAB_URL=http://192.168.15.4
GITLAB_TOKEN=<seu_personal_access_token>
GITLAB_PROJECT_ID=<id_do_projeto>        # ou namespace/projeto ex: gmontinny/ia-skill
GITLAB_BRANCH=main

# ─── Cache ─────────────────────────────────────────────────────────────────────
# TTL em segundos para o cache de skills (padrão: 5 minutos)
SKILL_CACHE_TTL=300

# ─── Log ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
